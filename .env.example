# Lakebase Database Connection String
# Replace placeholders with your actual Lakebase Postgres credentials

DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?sslmode=require

# Example format:
# DATABASE_URL=postgresql://myuser:mypassword@ep-example-123456.us-east-1.aws.neon.tech:5432/support_tickets?sslmode=require
